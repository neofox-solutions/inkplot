{
  "compilerOptions": {
    "target": "es2022", "module": "esnext", "moduleResolution": "bundler",
    "lib": ["es2022", "dom"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true, "noUnusedLocals": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "allowImportingTsExtensions": true,
    "noEmit": true, "jsx": "react-jsx", "skipLibCheck": true,
    "paths": { "inkplot": ["./src/index.ts"], "inkplot/*": ["./src/*.ts"], "playground/*": ["./playground/*"] }
  },
  "include": ["src/*.ts", "src/*.tsx", "tools/*.ts", "*.ts", "scratch/src/*.ts", "cli/*.ts", "playground/*.ts", "playground/*.tsx", "playground/*/*.ts", "playground/*/*.tsx"]
}
